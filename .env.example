# Copy to .env (never commit it). Create the key at https://adaptionlabs.ai/app/settings?tab=api_keys
ADAPTION_API_KEY=
# After you deploy a model or stack in the Adaption app, put its id or stack slug here, e.g. stack:wattback
ADAPTION_MODEL=
# Optional shared tariff registry (JSON file, same shape as data/tariffs.json)
TARIFF_REGISTRY_URL=
GOOGLE_CLIENT_ID=
SESSION_SECRET=
CONTACT_EMAIL=
